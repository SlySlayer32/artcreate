ENV=local
LOG_LEVEL=INFO

# Shared infrastructure
POSTGRES_DSN=postgresql+asyncpg://world:world@postgres:5432/world_narrator
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=world-narrator

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# API Gateway
SERVICE_NAME=api-gateway
PORT=8000
ENABLE_MOCK_PIPELINE=true
REQUIRE_API_KEY=false
IMAGE_PROCESSOR_URL=http://image-processor:8001
DOCUMENT_INTELLIGENCE_URL=http://document-intelligence:8002
NARRATION_DIRECTOR_URL=http://narration-director:8003
VOICE_SYNTHESIS_URL=http://voice-synthesis:8004
AUDIO_STREAMER_URL=http://audio-streamer:8005

# AI Providers
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
